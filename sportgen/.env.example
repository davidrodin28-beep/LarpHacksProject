# Any OpenAI-compatible endpoint. Pick ONE preset below. Check what your key unlocks: `sportgen --list-models`

# --- NVIDIA build.nvidia.com, Nemotron 3 Ultra 550B (FREE, no card, ~40 RPM) -- default.
#     Key: https://build.nvidia.com -> your profile -> API keys. Most faithful output measured (fit 5/5,
#     25/30). Slow: 25-30 s per call, 2-5 min per generation; the endpoint sometimes answers a transient
#     "404 page not found" which we retry. nemotron-3-super-120b and kimi-k2.6 are listed but 404 (not deployed).
SPORTGEN_API_KEY=
SPORTGEN_BASE_URL=https://integrate.api.nvidia.com/v1
SPORTGEN_MODEL=nvidia/nemotron-3-ultra-550b-a55b
#SPORTGEN_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b   # same key, ~10 s per generation, blander (21-23/30)

# --- Google Gemini Flash (FREE, no card). Key: https://aistudio.google.com/apikey
#     Native json_schema structured output. Free tier ~15 RPM on Flash-Lite; use 3.1-flash-lite if 3.8 429s.
#SPORTGEN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#SPORTGEN_MODEL=gemini-3.8-flash

# --- Groq (FREE, no card, ~500 tok/s). Key: https://console.groq.com/keys
#     Only 8K tokens/minute per model on the free plan: one generation (~15-20K tokens) overruns it.
#SPORTGEN_BASE_URL=https://api.groq.com/openai/v1
#SPORTGEN_MODEL=openai/gpt-oss-120b
#SPORTGEN_CANDIDATES=2

# --- Ollama on this Mac (FREE, unlimited, offline demo fallback). `ollama pull qwen3:8b`
#SPORTGEN_API_KEY=
#SPORTGEN_BASE_URL=http://localhost:11434/v1
#SPORTGEN_MODEL=qwen3:8b
#SPORTGEN_CANDIDATES=3

# --- Nebius Token Factory (paid credits). Bake-off: Qwen3.5-397B 25-27/30 18s; gpt-oss-120b 25/30 23s;
#     Nemotron-3.5-Lightning 21-23/30 9s; Kimi-K3 27/30 but 186s.
#SPORTGEN_BASE_URL=https://api.tokenfactory.nebius.com/v1/
#SPORTGEN_MODEL=Qwen/Qwen3.5-397B-A17B

# Pipeline knobs
SPORTGEN_CANDIDATES=5               # parallel candidates, one per twist category
SPORTGEN_CANDIDATE_TEMPERATURE=0.85 # lower = more faithful to constraints, higher = wilder

# Separate key for the fast engine (optional; same build.nvidia.com key works for both)
SPORTGEN_FAST_API_KEY=
SPORTGEN_THINK=true                 # hidden reasoning on every step for Ultra; the fast engine always runs with it off
